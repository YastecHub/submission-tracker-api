generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  cr
  acr
  fin_sec
  dev
  /// Runs elections only (open, pause, close, publish). No class rep access.
  electoral_committee
}

model User {
  id                     String                 @id @default(uuid())
  email                  String                 @unique
  passwordHash           String
  name                   String
  role                   UserRole               @default(cr)
  hasLoggedInBefore      Boolean                @default(false)
  pushSubscription       String?
  createdAt              DateTime               @default(now())
  events                 SubmissionEvent[]
  paymentEvents          PaymentEvent[]
  transactions           Transaction[]
  announcementsCreated   Announcement[]         @relation("AnnouncementCreatedBy")
  announcementsUpdated   Announcement[]         @relation("AnnouncementUpdatedBy")
  announcementsPublished Announcement[]         @relation("AnnouncementPublishedBy")
  announcementRevisions  AnnouncementRevision[] @relation("AnnouncementRevisionCreatedBy")
  announcementAiRuns     AnnouncementAiRun[]    @relation("AnnouncementAiRunRequestedBy")
  announcementMedia      AnnouncementMedia[]    @relation("AnnouncementMediaCreatedBy")
  electionsCreated       Election[]             @relation("ElectionCreatedBy")
  electionApprovals      ElectionPublishApproval[]
}

model StudentAccount {
  id                String             @id @default(uuid())
  matricNumber      String             @unique
  email             String             @unique
  fullName          String
  passwordHash      String
  /// Set when the password is reset; tokens issued before it are rejected.
  passwordChangedAt DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  announcementReads AnnouncementRead[]
  pushSubscriptions StudentPushSubscription[]
  gpaSemesters      GpaSemester[]
  passwordReset     StudentPasswordResetOtp?
  /// Set by the electoral committee; a suspended account cannot sign in or vote.
  suspendedAt       DateTime?
  suspendedReason   String?
  electionVotes     ElectionVoteRecord[]
}

model StudentRoster {
  id           String   @id @default(uuid())
  matricNumber String   @unique
  fullName     String
  /// Seeded email (e.g. JUPEB students): registration codes for this matric go only here.
  email        String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StudentRegistrationOtp {
  id           String   @id @default(uuid())
  matricNumber String   @unique
  email        String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

/// One live "forgot password" code per student account (bcrypt-hashed).
model StudentPasswordResetOtp {
  id         String         @id @default(uuid())
  studentId  String         @unique
  codeHash   String
  attempts   Int            @default(0)
  expiresAt  DateTime
  lastSentAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  student    StudentAccount @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model SubmissionEvent {
  id          String       @id @default(uuid())
  slug        String       @unique
  title       String
  courseCode  String
  type        EventType    @default(assignment)
  description String?
  deadline    DateTime
  isClosed    Boolean      @default(false)
  isDeleted   Boolean      @default(false)
  createdBy   String
  user        User         @relation(fields: [createdBy], references: [id])
  createdAt   DateTime     @default(now())
  submissions Submission[]

  @@index([isDeleted, createdAt])
  @@index([createdBy, isDeleted])
  @@index([deadline])
}

enum EventType {
  assignment
  attendance
  lab
  other
}

model Submission {
  id           String          @id @default(uuid())
  eventId      String
  event        SubmissionEvent @relation(fields: [eventId], references: [id])
  fullName     String
  matricNumber String
  level        String?
  qrCode       String
  submittedAt  DateTime        @default(now())
  isConfirmed  Boolean         @default(false)
  confirmedAt  DateTime?
  confirmedBy  String?

  @@unique([matricNumber, eventId])
  @@index([eventId, fullName])
  @@index([eventId, matricNumber])
  @@index([eventId, isConfirmed])
  @@index([eventId, submittedAt])
  @@index([eventId, isConfirmed, confirmedAt])
  @@index([matricNumber, submittedAt])
}

enum PaymentStatus {
  pending
  confirmed
  rejected
}

enum AmountCheckStatus {
  pending
  matched
  mismatch
  unreadable
  unavailable
}

model PaymentEvent {
  id            String           @id @default(uuid())
  slug          String           @unique
  title         String
  description   String?
  amount        Decimal          @db.Decimal(10, 2)
  accountNumber String
  accountName   String
  bankName      String
  deadline      DateTime
  hasTickets    Boolean          @default(false)
  isClosed      Boolean          @default(false)
  isDeleted     Boolean          @default(false)
  createdBy     String
  creator       User             @relation(fields: [createdBy], references: [id])
  createdAt     DateTime         @default(now())
  receipts      PaymentReceipt[]
  announcements Announcement[]

  @@index([isDeleted, createdAt])
  @@index([createdBy, isDeleted])
  @@index([deadline])
}

enum AnnouncementStatus {
  draft
  published
  archived
}

enum AnnouncementCategory {
  general
  academic
  practical
  finance
  event
  opportunity
  emergency
}

enum AnnouncementPriority {
  normal
  important
  urgent
}

enum AnnouncementSourceType {
  official_class
  educational_contribution
  lecturer_information
  external_information
}

enum AnnouncementAiRunStatus {
  completed
  failed
}

enum NotificationOutboxStatus {
  pending
  processing
  delivered
  dead
}

model Announcement {
  id                      String                 @id @default(uuid())
  slug                    String                 @unique
  title                   String
  summary                 String
  content                 Json
  rawSource               String?
  category                AnnouncementCategory   @default(general)
  priority                AnnouncementPriority   @default(normal)
  status                  AnnouncementStatus     @default(draft)
  sourceType              AnnouncementSourceType @default(official_class)
  contributorName         String?
  contributorCredit       String?
  isPinned                Boolean                @default(false)
  requiresAcknowledgement Boolean                @default(false)
  paymentEventId          String?
  paymentEvent            PaymentEvent?          @relation(fields: [paymentEventId], references: [id])
  version                 Int                    @default(1)
  createdBy               String
  creator                 User                   @relation("AnnouncementCreatedBy", fields: [createdBy], references: [id])
  updatedBy               String
  updater                 User                   @relation("AnnouncementUpdatedBy", fields: [updatedBy], references: [id])
  publishedBy             String?
  publisher               User?                  @relation("AnnouncementPublishedBy", fields: [publishedBy], references: [id])
  publishedAt             DateTime?
  archivedAt              DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  revisions               AnnouncementRevision[]
  reads                   AnnouncementRead[]
  aiRuns                  AnnouncementAiRun[]
  media                   AnnouncementMedia[]
  notificationOutbox      NotificationOutbox[]

  @@index([status, isPinned, publishedAt])
  @@index([status, category, publishedAt])
  @@index([createdBy, status, updatedAt])
  @@index([paymentEventId])
}

model AnnouncementAiRun {
  id               String        @id @default(uuid())
  announcementId   String?
  announcement     Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  requestedBy      String
  requester        User          @relation("AnnouncementAiRunRequestedBy", fields: [requestedBy], references: [id])
  provider         String
  model            String
  promptVersion    String
  sourceHash       String
  sourceLength     Int
  status           AnnouncementAiRunStatus
  result           Json?
  acceptedFields   Json?
  acceptedAt       DateTime?
  latencyMs        Int?
  errorCode        String?
  createdAt        DateTime      @default(now())

  @@index([requestedBy, createdAt])
  @@index([announcementId, createdAt])
}

model AnnouncementMedia {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  publicId       String       @unique
  url            String
  thumbnailUrl   String
  altText        String
  caption        String?
  sectionId      String?
  sortOrder      Int          @default(0)
  width          Int
  height         Int
  bytes          Int
  format         String
  createdBy      String
  creator        User         @relation("AnnouncementMediaCreatedBy", fields: [createdBy], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([announcementId, sortOrder])
  @@index([announcementId, sectionId, sortOrder])
}

model AnnouncementRevision {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  version        Int
  title          String
  summary        String
  content        Json
  media          Json         @default("[]")
  changeNote     String?
  origin         String       @default("manual")
  createdBy      String
  creator        User         @relation("AnnouncementRevisionCreatedBy", fields: [createdBy], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([announcementId, version])
  @@index([announcementId, createdAt])
}

model AnnouncementRead {
  id                  String         @id @default(uuid())
  announcementId      String
  announcement        Announcement   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  studentId           String
  student             StudentAccount @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lastReadVersion     Int
  firstReadAt         DateTime       @default(now())
  lastReadAt          DateTime       @default(now())
  acknowledgedVersion Int?
  acknowledgedAt      DateTime?

  @@unique([announcementId, studentId])
  @@index([studentId, lastReadAt])
}

model StudentPushSubscription {
  id             String                    @id @default(uuid())
  studentId      String
  student        StudentAccount            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  endpoint       String                    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  userAgent      String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  lastSeenAt     DateTime                  @default(now())
  outbox         NotificationOutbox[]

  @@index([studentId, updatedAt])
}

model NotificationOutbox {
  id                  String                    @id @default(uuid())
  subscriptionId      String?
  subscription        StudentPushSubscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// Empty for notices that aren't Bulletin posts (e.g. election notices).
  announcementId      String?
  announcement        Announcement?             @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementVersion Int?
  payload             Json
  status              NotificationOutboxStatus  @default(pending)
  attempts            Int                       @default(0)
  availableAt         DateTime                  @default(now())
  lockedAt            DateTime?
  deliveredAt         DateTime?
  lastError           String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([subscriptionId, announcementId, announcementVersion])
  @@index([status, availableAt, createdAt])
  @@index([announcementId, announcementVersion])
}

model PaymentReceipt {
  id                    String            @id @default(uuid())
  eventId               String
  event                 PaymentEvent      @relation(fields: [eventId], references: [id])
  fullName              String
  matricNumber          String
  level                 String?
  extractedAmount       Decimal?          @db.Decimal(10, 2)
  amountCheckStatus     AmountCheckStatus @default(pending)
  amountCheckConfidence Float?
  amountCheckNote       String?
  amountCheckedAt       DateTime?
  receiptUrl            String
  receiptPublicId       String
  submittedAt           DateTime          @default(now())
  status                PaymentStatus     @default(pending)
  confirmedAt           DateTime?
  confirmedBy           String?
  note                  String?
  ticketQrCode          String?
  isClaimed             Boolean           @default(false)
  claimedAt             DateTime?
  claimedBy             String?
  transaction           Transaction?

  @@unique([matricNumber, eventId])
  @@index([eventId, fullName])
  @@index([eventId, matricNumber])
  @@index([eventId, status])
  @@index([eventId, isClaimed])
  @@index([eventId, amountCheckStatus])
  @@index([eventId, submittedAt])
  @@index([eventId, status, submittedAt])
  @@index([eventId, status, confirmedAt])
  @@index([matricNumber, status])
  @@index([matricNumber, submittedAt])
  @@index([status, confirmedAt])
}

enum TransactionType {
  credit
  debit
}

model Transaction {
  id            String          @id @default(uuid())
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  description   String
  category      String?
  occurredAt    DateTime
  proofUrl      String?
  proofPublicId String?
  recordedBy    String
  recorder      User            @relation(fields: [recordedBy], references: [id])
  receiptId     String?         @unique
  receipt       PaymentReceipt? @relation(fields: [receiptId], references: [id])
  isDeleted     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([occurredAt])
  @@index([isDeleted])
  @@index([isDeleted, occurredAt, createdAt])
  @@index([isDeleted, type, occurredAt])
  @@index([isDeleted, category, occurredAt])
  @@index([recordedBy])
}

// ---------------------------------------------------------------------------
// GPA tracker (student-only). 5.0 scale. Grades are self-reported by students.
// ---------------------------------------------------------------------------

enum GpaGrade {
  A
  B
  C
  D
  E
  F
}

enum GpaSemesterStatus {
  draft
  finalized
}

/// Department course list, maintained by the developer with `npm run db:seed:catalog`.
model CourseCatalog {
  id         String      @id @default(uuid())
  code       String      @unique
  title      String
  units      Int
  level      Int
  semester   Int
  isElective Boolean     @default(false)
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  gpaCourses GpaCourse[]

  @@index([isActive, level, semester, sortOrder])
}

model GpaSemester {
  id           String            @id @default(uuid())
  studentId    String
  student      StudentAccount    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level        Int
  semester     Int
  sessionLabel String?
  status       GpaSemesterStatus @default(draft)
  finalizedAt  DateTime?
  version      Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  courses      GpaCourse[]

  @@unique([studentId, level, semester])
}

/// A course on a student's semester. Code, title and units are copied from the
/// catalog when added, so later catalog changes never rewrite a student's history.
model GpaCourse {
  id              String         @id @default(uuid())
  semesterId      String
  semester        GpaSemester    @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  catalogCourseId String?
  catalogCourse   CourseCatalog? @relation(fields: [catalogCourseId], references: [id], onDelete: SetNull)
  code            String
  title           String
  units           Int
  grade           GpaGrade?
  isCarryover     Boolean        @default(false)
  isRetake        Boolean        @default(false)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([semesterId, code])
  @@index([catalogCourseId])
}

// ---------------------------------------------------------------------------
// Elections. Secret ballot: ElectionVoteRecord says WHO voted, ElectionBallot says
// WHAT was voted, and nothing links the two.
// ---------------------------------------------------------------------------

enum ElectionStatus {
  draft
  ready
  open
  paused
  closed
  published
}

model Election {
  id                   String                    @id @default(uuid())
  title                String
  description          String?
  status               ElectionStatus            @default(draft)
  /// Rehearsal elections can be deleted even after votes.
  isTest               Boolean                   @default(false)
  opensAt              DateTime
  closesAt             DateTime
  /// Accounts created after this cannot vote in this election.
  registrationDeadline DateTime?
  openedAt             DateTime?
  closedAt             DateTime?
  publishedAt          DateTime?
  createdById          String
  version              Int                       @default(1)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  createdBy            User                      @relation("ElectionCreatedBy", fields: [createdById], references: [id])
  positions            ElectionPosition[]
  candidates           ElectionCandidate[]
  voterRoll            ElectionVoterRoll[]
  voteRecords          ElectionVoteRecord[]
  ballots              ElectionBallot[]
  publishApprovals     ElectionPublishApproval[]
  auditLogs            ElectionAuditLog[]
  notifications        ElectionNotification[]

  @@index([status])
}

/// A notice sent for an election (push, plus email for "voting is open"). The key makes it once-only.
model ElectionNotification {
  id         String   @id @default(uuid())
  electionId String
  key        String
  kind       String
  sentByName String?
  pushQueued Int      @default(0)
  emailsSent Int      @default(0)
  createdAt  DateTime @default(now())
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([electionId, key])
}

model ElectionPosition {
  id         String                 @id @default(uuid())
  electionId String
  title      String
  sortOrder  Int                    @default(0)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  election   Election               @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidates ElectionCandidate[]
  choices    ElectionBallotChoice[]

  @@index([electionId, sortOrder])
}

model ElectionCandidate {
  id            String                 @id @default(uuid())
  electionId    String
  positionId    String
  matricNumber  String?
  displayName   String
  nickname      String?
  photoUrl      String?
  photoPublicId String?
  manifesto     String?
  sortOrder     Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  election      Election               @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position      ElectionPosition       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  choices       ElectionBallotChoice[]

  @@index([positionId, sortOrder])
  @@index([electionId])
}

/// Who may vote in an election (uploaded voter list).
model ElectionVoterRoll {
  electionId   String
  matricNumber String
  fullName     String
  createdAt    DateTime @default(now())
  election     Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@id([electionId, matricNumber])
}

/// Who has voted. No choices here.
model ElectionVoteRecord {
  id           String         @id @default(uuid())
  electionId   String
  studentId    String
  matricNumber String
  /// Client-generated id of the submission, so a retried request is recognised.
  requestId    String
  votedAt      DateTime       @default(now())
  election     Election       @relation(fields: [electionId], references: [id], onDelete: Cascade)
  student      StudentAccount @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([electionId, matricNumber])
  @@unique([electionId, studentId])
  @@index([electionId, votedAt])
  @@index([studentId])
}

/// What was voted. No student here; time kept only to the hour.
model ElectionBallot {
  id          String                 @id @default(uuid())
  electionId  String
  receiptHash String
  castHour    DateTime
  election    Election               @relation(fields: [electionId], references: [id], onDelete: Cascade)
  choices     ElectionBallotChoice[]

  @@unique([electionId, receiptHash])
}

model ElectionBallotChoice {
  id          String            @id @default(uuid())
  ballotId    String
  positionId  String
  candidateId String
  /// Yes/No vote for an unopposed candidate; null in contested positions.
  approve     Boolean?
  ballot      ElectionBallot    @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  // Cascade only matters when a whole (test) election is deleted; candidates and
  // positions can't be removed once voting is possible.
  position    ElectionPosition  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidate   ElectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([ballotId, positionId])
  @@index([positionId, candidateId])
  @@index([candidateId])
}

model ElectionPublishApproval {
  electionId String
  userId     String
  createdAt  DateTime @default(now())
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([electionId, userId])
  @@index([userId])
}

model ElectionAuditLog {
  id          String   @id @default(uuid())
  electionId  String
  actorUserId String?
  actorName   String
  actorRole   String
  action      String
  detail      Json?
  createdAt   DateTime @default(now())
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId, createdAt])
}
