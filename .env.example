# Supabase connection pooler URL (used at runtime via pgbouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Supabase direct URL (used for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# JWT secret — use a long random string in production
JWT_SECRET=your_long_random_secret_here

# Port (Render sets this automatically)
PORT=3001

# Frontend URL for CORS (set to your Vercel URL in production)
CLIENT_URL=https://your-app.vercel.app

# Public backend URL used in Swagger and startup output.
PUBLIC_API_URL=https://your-api.example.com

# Student verification emails. MAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM="NEXIUM <students@your-verified-domain.example>"

# Optional: fast Groq vision amount extraction. Uploads still work if unset.
GROQ_API_KEY=
GROQ_RECEIPT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: Nexium Bulletin organization assistant. BULLETIN_AI_API_KEY falls back to GROQ_API_KEY.
BULLETIN_AI_PROVIDER=groq
BULLETIN_AI_API_KEY=
BULLETIN_AI_MODEL=openai/gpt-oss-20b
BULLETIN_AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
BULLETIN_AI_TIMEOUT_MS=20000
